# Reference: <https://nura.eco/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Xiaomi Redmi Note 10 5G"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-camellia"
deviceinfo_year="2021"
deviceinfo_dtb=""
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_initfs_compression="gzip"
# macOS has no RNDIS driver; NCM works on macOS, Linux and Windows
deviceinfo_usb_network_function="ncm.usb0"

# Bootloader related
deviceinfo_flash_method="fastboot"
# bootopt is read by LK; initcall_debug=0 overrides initcall_debug=1 from the dts bootargs
deviceinfo_kernel_cmdline="bootopt=64S3,32N2,64N2 initcall_debug=0"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_pagesize="2048"
deviceinfo_bootimg_qcdt="false"
deviceinfo_header_version="2"
deviceinfo_append_dtb="false"
# The boot.img dtb is a DT table with one entry (mediatek/mt6833.dtb), same as Lineage's
# dtb.img; LK picks the entry (androidboot.dtb_idx=0). Custom args replace the generated
# --header_version/--dtb arguments, so both are given here.
deviceinfo_bootimg_custom_args="--header_version 2 --dtb /boot/dtb-xiaomi-camellia.img --dtb_offset 0x07c08000"
deviceinfo_flash_offset_dtb="0x07c08000"
deviceinfo_flash_offset_base="0x40078000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x11088000"
deviceinfo_flash_offset_second="0xbff88000"
deviceinfo_flash_offset_tags="0x07c08000"
deviceinfo_flash_fastboot_partition_kernel="boot"
deviceinfo_flash_fastboot_partition_rootfs="userdata"
deviceinfo_flash_fastboot_partition_vbmeta="vbmeta"
# UFS storage with 4096-byte logical sectors
deviceinfo_rootfs_image_sector_size="4096"
