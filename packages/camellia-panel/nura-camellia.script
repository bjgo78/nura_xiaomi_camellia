# Nura boot splash for camellia: wordmark and device name, a progress bar
# (Plymouth's estimate from the previous boot) and the current step, from the
# initramfs ("Loading") and the OpenRC plugin ("Starting service <name>").
# Same background colour as camellia-panel, so the handover is seamless.

Window.SetBackgroundTopColor(0.082, 0.090, 0.102);
Window.SetBackgroundBottomColor(0.082, 0.090, 0.102);

screen.w = Window.GetWidth(0);
screen.h = Window.GetHeight(0);

logo.image = Image("nura-logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + screen.w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + screen.h * 0.40 - logo.image.GetHeight() / 2);

bar.bg = Image("nura-bar-bg.png");
bar.fg = Image("nura-bar-fg.png");
bar.x = Window.GetX() + screen.w / 2 - bar.bg.GetWidth() / 2;
bar.y = Window.GetY() + screen.h * 0.62;
bar.bg_sprite = Sprite(bar.bg);
bar.bg_sprite.SetPosition(bar.x, bar.y, 1);
bar.fg_sprite = Sprite();
bar.fg_sprite.SetPosition(bar.x, bar.y, 2);

msg.sprite = Sprite();
msg.sprite.SetZ(3);

if (Plymouth.GetMode() == "shutdown") {
	bar.bg_sprite.SetOpacity(0);
	bar.fg_sprite.SetOpacity(0);
}

fun progress_callback(duration, progress) {
	w = Math.Int(bar.bg.GetWidth() * progress);
	if (w < bar.fg.GetHeight())
		w = bar.fg.GetHeight();
	bar.fg_sprite.SetImage(bar.fg.Scale(w, bar.fg.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

fun message_callback(text) {
	prefix = "Starting service ";
	if (text.SubString(0, 17) == prefix)
		text = "Starting " + text.SubString(17, 200);
	prefix = "Stopping service ";
	if (text.SubString(0, 17) == prefix)
		text = "Stopping " + text.SubString(17, 200);
	msg.image = Image.Text(text, 0.75, 0.77, 0.80, 1, "Sans 32");
	msg.sprite.SetImage(msg.image);
	msg.sprite.SetX(Window.GetX() + screen.w / 2 - msg.image.GetWidth() / 2);
	msg.sprite.SetY(bar.y + 70);
}
Plymouth.SetMessageFunction(message_callback);
