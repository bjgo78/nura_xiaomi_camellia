#!/bin/sh
# Manual Wi-Fi bring-up for camellia (until the OpenRC services exist):
# WMT loader ioctls -> wmt-launcher -> NVRAM push -> Wi-Fi on.
set -e
echo 1 > /sys/class/firmware/timeout
python3 - <<'PY'
import os, fcntl, errno
def IOR(nr): return (2 << 30) | (4 << 16) | (ord('w') << 8) | nr
fd = os.open('/dev/wmtdetect', os.O_RDWR)
try:
    fcntl.ioctl(fd, IOR(10), 0)
except OSError as e:
    if e.errno != errno.EBUSY:
        raise
chip = fcntl.ioctl(fd, IOR(3), 0)
fcntl.ioctl(fd, IOR(1), chip)
fcntl.ioctl(fd, IOR(9), 0)
fcntl.ioctl(fd, IOR(5), chip)
fcntl.ioctl(fd, IOR(4), chip)
print('wmt loader: chip 0x%04x initialized' % chip)
PY
pgrep -f wmt-launcher >/dev/null || { /usr/local/sbin/wmt-launcher > /tmp/wmt-launcher.log 2>&1 & sleep 1; }
mkdir -p /mnt/vendor/nvdata
mountpoint -q /mnt/vendor/nvdata || mount -o ro /dev/disk/by-partlabel/nvdata /mnt/vendor/nvdata
{ printf 'WR-BUF:NVRAM'; cat /mnt/vendor/nvdata/APCFG/APRDEB/WIFI; } > /tmp/nvram.buf
dd if=/tmp/nvram.buf of=/dev/wmtWifi bs=4096 count=1 2>/dev/null
echo 1 > /dev/wmtWifi
sleep 2
nmcli device set ap0 managed no 2>/dev/null || true
nmcli device set p2p0 managed no 2>/dev/null || true
ip -br link show wlan0
